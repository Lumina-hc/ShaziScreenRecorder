<Window x:Class="ScreenRecorder.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="傻子录屏浮窗" Width="252" Height="66"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" SnapsToDevicePixels="True">

    <Border x:Name="Root" CornerRadius="16" Background="#F2212121" BorderBrush="#3A3A3A" BorderThickness="1"
            MouseLeftButtonDown="Root_MouseLeftButtonDown" MouseRightButtonUp="Root_MouseRightButtonUp">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="2" Opacity="0.55"/>
        </Border.Effect>
        <Grid Margin="12,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="Btn" Width="42" Height="42" Cursor="Hand" MouseLeftButtonUp="Btn_MouseLeftButtonUp" VerticalAlignment="Center">
                <Ellipse x:Name="Core" Width="32" Height="32" Fill="{StaticResource Rec}"/>
                <Rectangle x:Name="Stop" Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="White" Visibility="Collapsed"/>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                <TextBlock x:Name="TimeText" Text="00:00:00" FontFamily="Consolas, Cascadia Mono" FontSize="17" Foreground="{StaticResource Text}"/>
                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                    <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StateText" Text="就绪" FontSize="10.5" Foreground="{StaticResource SubText}" Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Width="30" Height="30" Click="Expand_Click" ToolTip="展开主窗口">
                    <Path Data="{StaticResource IcoExpand}" Stroke="{StaticResource SubText}" StrokeThickness="1.3"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Width="30" Height="30" Click="Close_Click" ToolTip="关闭浮窗">
                    <Path Data="{StaticResource IcoClose}" Stroke="{StaticResource SubText}" StrokeThickness="1.3"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
